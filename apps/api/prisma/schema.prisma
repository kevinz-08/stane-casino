// Core data model. Chip amounts are BigInt (integer chips, never floats).
// Invariants Prisma cannot express (CHECKs, immutability triggers, balanced transactions,
// system-account uniqueness) live in the SQL of the migrations: see
// prisma/migrations/*_init/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

enum AccountType {
  PLAYER_WALLET // one per user and currency; balance can never go below 0
  HOUSE // system: counterpart of every bet/payout
  FAUCET // system: issuer of chip grants (its balance goes negative = chips in circulation)
}

/// From the point of view of the account: DEBIT takes chips out, CREDIT puts chips in.
enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerReason {
  INITIAL_GRANT
  BET
  PAYOUT
  REFUND
  ADJUSTMENT
}

enum GameType {
  BLACKJACK
  SLOTS
}

enum RoundStatus {
  CREATED
  IN_PROGRESS
  SETTLED
  VOIDED
}

enum SeedStatus {
  ACTIVE
  REVEALED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique // stored lower-cased
  passwordHash String
  displayName  String
  role         Role     @default(PLAYER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts      Account[]
  rounds        GameRound[]
  seedPairs     SeedPair[]
  refreshTokens RefreshToken[]
}

/// Opaque refresh tokens (owned by `auth`). Only a SHA-256 of the secret is stored.
/// Rotation: every refresh revokes the token and issues a new one in the same `familyId`.
/// Presenting an already revoked token revokes the whole family (reuse detection).
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  familyId     String
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Account {
  id        String      @id @default(cuid())
  userId    String? // null for system accounts (HOUSE, FAUCET)
  type      AccountType
  currency  String      @default("CHIP")
  // Cached balance, updated in the same DB transaction as the entries. The ledger is the
  // source of truth: balance == Σ CREDIT − Σ DEBIT of the account's entries.
  balance   BigInt      @default(0)
  createdAt DateTime    @default(now())

  user    User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@unique([userId, type, currency])
}

/// One business operation (a bet, a payout, a grant...). Immutable.
/// `idempotencyKey` is unique: repeating an operation with the same key returns the original
/// transaction; reusing the key with a different payload (`requestHash`) is rejected.
model LedgerTransaction {
  id             String       @id @default(cuid())
  idempotencyKey String       @unique
  requestHash    String
  reason         LedgerReason
  roundId        String?
  createdAt      DateTime     @default(now())

  round   GameRound?    @relation(fields: [roundId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@index([roundId])
}

/// Immutable, append-only. One row per leg of a double-entry transaction:
/// for every transaction Σ DEBIT == Σ CREDIT (enforced by a deferred constraint trigger).
model LedgerEntry {
  id            String          @id @default(cuid())
  transactionId String
  accountId     String
  direction     LedgerDirection
  amount        BigInt // always > 0; the sign comes from `direction`
  balanceAfter  BigInt // account balance right after this leg (running balance)
  createdAt     DateTime        @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     Account           @relation(fields: [accountId], references: [id])

  @@index([transactionId])
  @@index([accountId, createdAt])
}

model GameRound {
  id         String      @id @default(cuid())
  userId     String
  game       GameType
  status     RoundStatus @default(CREATED)
  bet        BigInt
  payout     BigInt?
  seedPairId String
  nonce      Int // nonce used for this round with the seed pair
  createdAt  DateTime    @default(now())
  settledAt  DateTime?

  user               User                @relation(fields: [userId], references: [id])
  seedPair           SeedPair            @relation(fields: [seedPairId], references: [id])
  events             RoundEvent[]
  ledgerTransactions LedgerTransaction[]

  @@unique([seedPairId, nonce])
  @@index([userId, createdAt])
}

/// Append-only event log: replaying `seq` 0..n reproduces the round.
model RoundEvent {
  id        String   @id @default(cuid())
  roundId   String
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now())

  round GameRound @relation(fields: [roundId], references: [id])

  @@unique([roundId, seq])
}

model SeedPair {
  id             String     @id @default(cuid())
  userId         String
  // TODO(fase-2): encrypt at rest while ACTIVE; only exposed after rotation.
  serverSeed     String
  serverSeedHash String // SHA-256(serverSeed), published before playing
  clientSeed     String
  nextNonce      Int        @default(0)
  status         SeedStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  revealedAt     DateTime?

  user   User        @relation(fields: [userId], references: [id])
  rounds GameRound[]

  @@index([userId, status])
}
