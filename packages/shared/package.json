{
  "name": "@casino/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types, DTOs, WS events and constants (no runtime deps).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@casino/config": "workspace:*",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
