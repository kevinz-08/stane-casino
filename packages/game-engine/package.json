{
  "name": "@casino/game-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Pure, deterministic game engine (no I/O, no clock, no Math.random).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "simulate:blackjack": "node scripts/simulate-blackjack.mjs"
  },
  "devDependencies": {
    "@casino/config": "workspace:*",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
