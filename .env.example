# Copy to .env and adjust. Never commit the real .env.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=casino
POSTGRES_PASSWORD=casino
POSTGRES_DB=casino
POSTGRES_PORT=5432
DATABASE_URL=postgresql://casino:casino@localhost:5432/casino?schema=public

# --- Redis (docker-compose.yml) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# TODO(phase-1): JWT_ACCESS_SECRET, JWT_REFRESH_SECRET
# TODO(phase-2): SERVER_SEED_ENCRYPTION_KEY (encrypts active serverSeeds at rest)

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
